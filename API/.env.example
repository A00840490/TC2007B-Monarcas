# Copy this file to API/.env and fill in the real values.
# API/.env is NOT committed to git.

# SQL Server database
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=database_name
# Never sa: use the least-privilege accounts of API/sql/04_app_users.sql.
DB_USER=caritas_api
DB_PASSWORD=change_me
# Account of the daily task (python -m tasks.daily_recurring_donations).
TASKS_DB_USER=caritas_tasks
TASKS_DB_PASSWORD=change_me

# API server
# Without API_HOST the API only listens on 127.0.0.1; 0.0.0.0 makes it reachable
# from other machines (the firewall decides who can connect).
API_HOST=0.0.0.0
API_PORT=10206
# Only true for local development; never on a publicly reachable server.
API_DEBUG=false

# HTTPS (see docs/https.md). Set both to serve HTTPS; leave empty for HTTP.
# SSL_CERT_FILE is the certificate signed by the professor's CA (if they also
# send an intermediate certificate, append it to the same file).
# Relative paths are resolved from the API/ folder. Neither file is committed.
SSL_CERT_FILE=certs/monarcas.tc2007b.tec.mx.cer
SSL_KEY_FILE=certs/monarcas.tc2007b.tec.mx.key

# Login JSON Web Tokens. Use a long random string (at least 32 characters, the
# API refuses to start otherwise), for example:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string
# Hours a token lasts before it expires.
JWT_EXP_HOURS=8

# Secret "pepper" mixed into every password hash (see API/sql/README.md, "Password
# hashes"). At least 32 characters, generated the same way as JWT_SECRET but different.
# Keep it only here, never in the database. Changing it invalidates every password.
PASSWORD_PEPPER=change_me_to_another_long_random_string

# Largest request body the API accepts, in bytes (default 1 MB; bigger → 413).
MAX_REQUEST_BYTES=1048576
