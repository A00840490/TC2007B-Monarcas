// Data model (SQL Server). Paste into https://dbdiagram.io to edit the diagram.
// Source of truth for the structure: API/sql/01_create_database.sql. Business rules: docs/database.md.

Project caritas {
  database_type: 'SQL Server'
}

Table Role {
  ID int [pk, increment]
  Name varchar(30) [not null, unique, note: 'Admin | Telefonista | Recolector']
}

Table Users {
  ID int [pk, increment]
  Name nvarchar(100) [not null]
  Email nvarchar(254) [not null, unique]
  PasswordHash varchar(255) [not null, note: 'Salted PBKDF2 of the hex SHA-256 + pepper']
  RoleID int [not null, ref: > Role.ID]
}

Table Donor {
  ID int [pk, increment]
  Name nvarchar(150) [not null]
  Phone varchar(20)
  Address nvarchar(300)
  RiskStatus varchar(10) [not null, default: 'LOW', note: 'LOW | MEDIUM | HIGH']
  Nickname nvarchar(60)
  Email nvarchar(254)
  OfficePhone varchar(20)
}

Table DonorNote {
  ID int [pk, increment]
  DonorID int [not null, ref: > Donor.ID]
  UserID int [not null, ref: > Users.ID, note: 'Telefonista who wrote it']
  Note nvarchar(1000) [not null]
  CreatedAt datetime2 [not null, default: `SYSDATETIME()`]
  Note: 'Telefonista log about a donor'
}

Table Donation {
  ID int [pk, increment]
  DonorID int [not null, ref: > Donor.ID]
  DonationDate datetime2 [not null, note: 'Never in the future']
  TotalAmount decimal(12,2) [not null]
  PaymentMethod varchar(20) [not null, note: 'CASH | TRANSFER']
  TargetCampaign nvarchar(100)
  Notes nvarchar(1000)
  CollectionID int [ref: > Collection.ID]
  CallID int [ref: > PhoneCall.ID]
  RecurringDonationID int [ref: > RecurringDonation.ID]
  Note: 'History: only money already received'
}

Table Collection {
  ID int [pk, increment]
  UserID int [not null, ref: > Users.ID, note: 'Recolector']
  DonorID int [not null, ref: > Donor.ID]
  Status varchar(20) [not null, default: 'PENDING', note: 'PENDING | SUCCESSFUL | FAILED']
  Notes nvarchar(1000)
  ScheduledDate datetime2 [not null]
  ExpectedAmount decimal(12,2)
  RouteOrder int
  CallID int [ref: > PhoneCall.ID]
  RecurringDonationID int [ref: > RecurringDonation.ID]
}

Table PhoneCall {
  ID int [pk, increment]
  UserID int [not null, ref: > Users.ID, note: 'Telefonista']
  DonorID int [not null, ref: > Donor.ID]
  Type varchar(30) [not null, default: 'REGULAR', note: 'REGULAR | CONFIRMATION | TRANSFER_COLLECTION']
  Status varchar(20) [not null, default: 'PENDING', note: 'PENDING | NO_ANSWER | DECLINED | ACCEPTED | RESCHEDULED']
  Notes nvarchar(1000)
  ScheduledDate datetime2 [not null]
  RecurringDonationID int [ref: > RecurringDonation.ID]
  CalledAt datetime2 [note: 'When the telefonista saved the result']
  ResultNotes nvarchar(1000) [note: 'What the telefonista wrote; Notes keeps the goal']
}

Table RecurringDonation {
  ID int [pk, increment]
  DonorID int [not null, ref: > Donor.ID]
  Amount decimal(12,2) [not null]
  PaymentMethod varchar(20) [not null, note: 'CASH | TRANSFER']
  TargetCampaign nvarchar(100)
  Frequency varchar(20) [not null, default: 'MONTHLY']
  StartDate date [not null]
  NextInstallmentDate date [not null]
  EndDate date
  Status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | PAUSED | CANCELLED | FINISHED']
  TelefonistaID int [not null, ref: > Users.ID]
  RecolectorID int [not null, ref: > Users.ID]
  OriginCallID int [ref: > PhoneCall.ID]
  OriginCollectionID int [ref: > Collection.ID]
  Notes nvarchar(1000)
  Note: 'Recurring donation pledges'
}
